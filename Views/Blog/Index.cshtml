@model IEnumerable<HariharanBlog.Models.BlogPost>

<h2>Blog Posts</h2>
<div class="list-group">
    @foreach (var post in Model)
    {
        <a href="@Url.Action("Details", "Blog", new { id = post.Id })" class="list-group-item">
            <h4 class="list-group-item-heading">@post.Title</h4>
            <p class="list-group-item-text">@post.Content.Substring(0, 100)...</p>
            <small>@post.CreatedAt.ToShortDateString()</small>
        </a>
    }
</div>
