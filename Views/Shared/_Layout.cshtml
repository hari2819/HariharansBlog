<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Hariharan's Blog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <header class="jumbotron text-center">
            <h1 class="display-3">Welcome to Hariharan's Blog</h1>
            <p class="lead">I am a Full Stack Developer with expertise in ASP.NET and React, passionate about building scalable and innovative solutions.</p>
        </header>

        <nav class="navbar navbar-expand-lg navbar-light bg-light mb-5">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">Hariharan's Blog</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Projects">Projects</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Blog">Blog</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Contact">Contact</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <main>
            @RenderBody()
        </main>

        <footer class="text-center mt-5">
            <p>&copy; @DateTime.Now.Year Hariharan Venkatesan</p>
            <div>
                <a href="https://github.com/username" class="btn btn-dark btn-sm" target="_blank">GitHub</a>
                <a href="https://www.linkedin.com/in/vengatesanhariharan" class="btn btn-dark btn-sm" target="_blank">LinkedIn</a>
            </div>
        </footer>
    </div>
</body>
</html>
